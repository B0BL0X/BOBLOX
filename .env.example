# Copy this file to .env and change the values.

# Your domain, without http:// (used in profile links). Must match the Caddyfile.
BOBLOX_SITE_DOMAIN=boblox.example.com

# Name shown on the site
BOBLOX_SITE_NAME=BOBLOX

# Owner links on the home page and in the footer (leave empty to hide them)
BOBLOX_OWNER_DISCORD_URL=
BOBLOX_CONTACT_EMAIL=

# Whether sign ups start open. The FIRST account becomes the administrator, so sign up
# right after starting the site. Afterwards use Admin -> Site to open or close sign ups.
BOBLOX_REGISTRATION_OPEN=true

# Port on 127.0.0.1 that Caddy forwards to
BOBLOX_PORT=8080
